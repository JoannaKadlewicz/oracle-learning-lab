# Copy to .env and adjust. Only non-secret settings belong here: passwords live in ./secrets/.

# Your Oracle 19c base image (built with github.com/oracle/docker-images; often oracle/database:19.3.0-ee).
ORACLE_BASE_IMAGE=oracledb:19.3.0

# Host folder for the database files (data/oradata) and the app's progress and notes (data/app).
DATA_DIR=./data

# Host ports, bound to 127.0.0.1 only.
LAB_PORT=8071
ORACLE_PORT=1525

# Database memory on first creation, in MB (set both or neither; default: chosen by Oracle).
ORACLE_SGA_MB=
ORACLE_PGA_MB=

# Use the Oracle 23ai container for the 1Z0-171 track (with: docker compose --profile 23ai up -d).
STUDY_DSN_23AI=

STUDY_LOG_LEVEL=INFO
